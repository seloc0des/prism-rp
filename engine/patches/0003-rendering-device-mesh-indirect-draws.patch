+	const uint64_t max_y = driver->limit_get(uses_task ? LIMIT_MAX_TASK_WORKGROUP_COUNT_Y : LIMIT_MAX_MESH_WORKGROUP_COUNT_Y);
+	const uint64_t max_z = driver->limit_get(uses_task ? LIMIT_MAX_TASK_WORKGROUP_COUNT_Z : LIMIT_MAX_MESH_WORKGROUP_COUNT_Z);
+	const uint64_t max_total = driver->limit_get(uses_task ? LIMIT_MAX_TASK_WORKGROUP_COUNT_TOTAL : LIMIT_MAX_MESH_WORKGROUP_COUNT_TOTAL);
+	ERR_FAIL_COND_MSG(p_x_count > max_x,
+			"Amount of X " + stage_name + " workgroups (" + itos(p_x_count) + ") is larger than device limit (" + itos(max_x) + ")");
+	ERR_FAIL_COND_MSG(p_y_count > max_y,
+			"Amount of Y " + stage_name + " workgroups (" + itos(p_y_count) + ") is larger than device limit (" + itos(max_y) + ")");
+	ERR_FAIL_COND_MSG(p_z_count > max_z,
+			"Amount of Z " + stage_name + " workgroups (" + itos(p_z_count) + ") is larger than device limit (" + itos(max_z) + ")");
+	ERR_FAIL_COND_MSG((uint64_t)p_x_count * p_y_count * p_z_count > max_total,
+			"Total amount of " + stage_name + " workgroups is larger than device limit (" + itos(max_total) + ")");
+#endif
+
+	if (!_draw_list_mesh_draw_prepare()) {
+		return;
+	}
+
 	draw_graph.add_draw_list_draw_mesh_tasks(p_x_count, p_y_count, p_z_count);
 
 	draw_list.state.draw_count++;
 }
 
+void RenderingDevice::draw_list_draw_mesh_tasks_indirect(DrawListID p_list, RID p_buffer, uint32_t p_offset, uint32_t p_draw_count, uint32_t p_stride) {
+	_draw_list_draw_mesh_tasks_indirect(p_buffer, p_offset, p_draw_count, p_stride, RID(), 0);
+}
+
+void RenderingDevice::draw_list_draw_mesh_tasks_indirect_count(DrawListID p_list, RID p_buffer, uint32_t p_offset, RID p_count_buffer, uint32_t p_count_buffer_offset, uint32_t p_max_draw_count, uint32_t p_stride) {
+	ERR_RENDER_THREAD_GUARD();
+
+	ERR_FAIL_COND_MSG(!has_feature(SUPPORTS_DRAW_INDIRECT_COUNT), "The current rendering device does not support indirect draws with a count buffer.");
+	ERR_FAIL_COND_MSG(!p_count_buffer.is_valid(), "A count buffer is required.");
+	ERR_FAIL_COND_MSG((p_count_buffer_offset % 4) != 0, "Offsets and stride must be multiples of 4.");
+
+	_draw_list_draw_mesh_tasks_indirect(p_buffer, p_offset, p_max_draw_count, p_stride, p_count_buffer, p_count_buffer_offset);
+}
+
+// With a valid p_count_buffer, p_draw_count is the maximum draw count and the GPU reads the actual count from the buffer.
+// The group counts inside the commands are written by the GPU, so they cannot be checked here.
+void RenderingDevice::_draw_list_draw_mesh_tasks_indirect(RID p_buffer, uint32_t p_offset, uint32_t p_draw_count, uint32_t p_stride, RID p_count_buffer, uint32_t p_count_buffer_offset) {
+	ERR_RENDER_THREAD_GUARD();
+
+	ERR_FAIL_COND(!draw_list.active);
+	ERR_FAIL_COND_MSG(!draw_list.state.pipeline_uses_mesh, "The bound render pipeline has no mesh shader.");
+	ERR_FAIL_COND_MSG((p_offset % 4) != 0 || (p_stride % 4) != 0, "Offsets and stride must be multiples of 4.");
+
+	// VkDrawMeshTasksIndirectCommandEXT: the X, Y and Z group counts.
+	const uint32_t command_size = 3 * sizeof(uint32_t);
+	ERR_FAIL_COND_MSG(p_draw_count > 1 && p_stride < command_size, "Stride must be at least 12 bytes (the size of a mesh tasks command) when drawing more than one command.");
+
+	Buffer *buffer = storage_buffer_owner.get_or_null(p_buffer);
+	ERR_FAIL_NULL(buffer);
+	ERR_FAIL_COND_MSG(!buffer->usage.has_flag(RDD::BUFFER_USAGE_INDIRECT_BIT), "Buffer provided was not created to do indirect dispatch.");
+	const uint64_t commands_end = (uint64_t)p_offset + (p_draw_count > 0 ? (uint64_t)(p_draw_count - 1) * p_stride + command_size : 0);
+	ERR_FAIL_COND_MSG(commands_end > buffer->size, "Mesh tasks commands extend past the end of the buffer.");
+
+	Buffer *count_buffer = nullptr;
+	if (p_count_buffer.is_valid()) {
+		count_buffer = storage_buffer_owner.get_or_null(p_count_buffer);
+		ERR_FAIL_NULL(count_buffer);
+		ERR_FAIL_COND_MSG(!count_buffer->usage.has_flag(RDD::BUFFER_USAGE_INDIRECT_BIT), "Count buffer provided was not created to do indirect dispatch.");
+		ERR_FAIL_COND_MSG(p_count_buffer_offset + 4 > count_buffer->size, "Count buffer offset provided (+4) is past the end of buffer.");
+	}
+
+	if (!_draw_list_mesh_draw_prepare()) {
+		return;
+	}
+
+	if (count_buffer != nullptr) {
+		draw_graph.add_draw_list_draw_mesh_tasks_indirect_count(buffer->driver_id, p_offset, count_buffer->driver_id, p_count_buffer_offset, p_draw_count, p_stride);
+	} else {
+		draw_graph.add_draw_list_draw_mesh_tasks_indirect(buffer->driver_id, p_offset, p_draw_count, p_stride);
+	}
+
+	draw_list.state.draw_count++;
+
+	if (buffer->draw_tracker != nullptr) {
+		draw_graph.add_draw_list_usage(buffer->draw_tracker, RDG::RESOURCE_USAGE_INDIRECT_BUFFER_READ);
+	}
+
+	_check_transfer_worker_buffer(buffer);
+
+	if (count_buffer != nullptr) {
+		if (count_buffer->draw_tracker != nullptr) {
+			draw_graph.add_draw_list_usage(count_buffer->draw_tracker, RDG::RESOURCE_USAGE_INDIRECT_BUFFER_READ);
+		}
+
+		_check_transfer_worker_buffer(count_buffer);
+	}
+}
